---
import '@/index.css';
import AppProviders from "@/components/AppProviders";
import CookieBanner from "@/components/CookieBanner";


interface Props {
	title: string;
	description?: string;
}

const isGerman = import.meta.env.VITE_SITE_LOCALE === 'de';
const defaultDescription = isGerman
	? 'Sphere Music Hub – entspannte Ambient-, Chillout- und Fokusmusik für ruhigere Momente, Konzentration und Erholung.'
	: 'Sphere Music Hub - Your destination for ambient, chillout, and focus music.';
const { title, description = defaultDescription } = Astro.props;
const pathname = Astro.url.pathname;
const canonicalBaseUrl = isGerman ? 'https://www.sphere-music-hub.de' : 'https://www.sphere-music-hub.com';
const canonicalURL = new URL(pathname, canonicalBaseUrl);
const germanURL = new URL(pathname, 'https://www.sphere-music-hub.de');
const englishURL = new URL(pathname, 'https://www.sphere-music-hub.com');
const language = isGerman ? 'de' : 'en';
---

<!doctype html>
<html lang={language} class="dark">
		<head>
			<link rel="canonical" href={canonicalURL} />
			<link rel="alternate" hreflang="de" href={germanURL} />
			<link rel="alternate" hreflang="en" href={englishURL} />
			<link rel="alternate" hreflang="x-default" href={englishURL} />

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
		
		<!-- Preconnect Resource Hints for Performance -->
		<link rel="preconnect" href="https://www.youtube.com" />
		<link rel="preconnect" href="https://i.ytimg.com" />
		<link rel="preconnect" href="https://img.youtube.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={isGerman ? 'entspannungsmusik, chillout musik, ambient musik, fokus musik, lernmusik, meditationsmusik, arbeitsmusik, konzentrationsmusik, klaviermusik, piano ambience' : 'relaxing music, chill music, ambient music, focus music, study music, chillout music, deep focus, meditation music, work music, concentration music, piano ambience'} />
		<meta name="author" content="Sphere Music Hub" />
		<meta name="google-site-verification" content="q1xeuuYyjgx3E35Apdhy2uqvTixkPHzKN97sYpE0X7M" />
		
		<!-- Google Analytics 4 - Deferred for better performance -->
		<script is:inline>
			window.addEventListener('load', function() {
				var script = document.createElement('script');
				script.async = true;
				script.src = 'https://www.googletagmanager.com/gtag/js?id=G-JJXK61KJNE';
				document.head.appendChild(script);
				
				window.dataLayer = window.dataLayer || [];
				function gtag(){dataLayer.push(arguments);}
				gtag('js', new Date());
				gtag('config', 'G-JJXK61KJNE');
			});
		</script>
		
		<!-- Preload critical assets for LCP optimization -->
		<link rel="preload" as="image" href="/logo-48.webp" type="image/webp" />
		<link rel="preload" as="image" href="/hero-bg.webp" type="image/webp" fetchpriority="high" />
		
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
		<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" /></noscript>
	</head>
			<body>
				<AppProviders client:load>
					<slot />
				</AppProviders>
				<CookieBanner client:load />
			</body>
</html>
